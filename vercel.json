{
  "buildCommand": "bun run build",
  "outputDirectory": "build",
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"gh-pages\" ]; then exit 0; else exit 1; fi'",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "env": {
    "PUBLIC_URL": ""
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
